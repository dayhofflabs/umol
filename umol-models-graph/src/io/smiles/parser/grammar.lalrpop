pub Isotope: u32 = { <mass:Number> => mass }

pub Chirality: Chirality = {
    "@" => Chirality::Clockwise,
    "@@" => Chirality::CounterClockwise,
    // @THn: accept 1/2 as aliases of @/@@; other digits keep Tetrahedral{arr}
    "@TH" <arr:Digit> => match arr { 1 => Chirality::Clockwise, 2 => Chirality::CounterClockwise, n => Chirality::Tetrahedral { arr: n } },
    "@AL" <arr:Digit> => Chirality::Allenal { arr},
    "@SP" <arr:Digit> => Chirality::SquarePlanar { arr},
    "@TB" <arr:Number> => Chirality::TrigonalBipyramidal { arr},
    "@OH" <arr:Number> => Chirality::Octahedral { arr},
}

pub HCount: u32 = { "H" => 1u32, "H" <count:Digit> => count }

pub Charge: i32 = {
    "+" => 1i32,
    "-" => -1i32,
    "++" => 2i32,
    "--" => -2i32,
    "+" <count:Digit> => count as i32,
    "-" <count:Digit> => -(count as i32),
}

pub Class: u32 = { ":" <index:Number> => index }

// Bond nonterminals
pub Bond: Bond = {
<order:BondOrder> =>? { state.stage_bond_order(order).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::from_order(order)) },
"/" =>? { state.stage_bond_dir(BondDir::Up).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::up()) },
"\\" =>? { state.stage_bond_dir(BondDir::Down).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::down()) },
":" =>? { state.stage_bond_order(BondOrder::Aromatic).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::from_order(BondOrder::Aromatic)) },
}

pub BondOrder: BondOrder = {
    "-" => BondOrder::Single,
    "=" => BondOrder::Double,
    "#" => BondOrder::Triple,
    "$" => BondOrder::Quadruple,
}

// Helper nonterminals

// ring sequences are represented by repeated Link::<Ring>

pub Ring: () = {
    <spec:RingSpec?> <ring:RingIndex> =>? {
        if state.rings.contains_key(&ring) {
            let spec_is_some = spec.is_some();
            let bond_info = spec.unwrap_or(BondInfo { order: BondOrder::Single, dir: None });
            let (start_atom, pending) = state.close_ring(ring).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?;
            let pending_is_some = pending.is_some();
            let use_spec = pending.unwrap_or(bond_info);
            let explicit = pending_is_some || spec_is_some;
            let rb = ResolvedBond { start_atom, end_atom: state.last_atom_idx, bond_index: state.bump_bond_idx(), bond: use_spec, explicit };
            state.push_resolved_bond(rb);
        } else {
            // Store spec only if provided; leave None to allow close-side spec to apply
            let _ = state.open_ring(ring, spec).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?;
        }
        Ok(())
    },
}

pub RingSpec: BondInfo = {
    <order:BondOrder> => BondInfo { order, dir: None },
    "/" => BondInfo { order: BondOrder::Single, dir: Some(BondDir::Up) },
    "\\" => BondInfo { order: BondOrder::Single, dir: Some(BondDir::Down) },
    ":" => BondInfo { order: BondOrder::Aromatic, dir: None },
}

pub RingIndex: u32 = { <Digit>, <"percent"> }

// Number helpers
pub Digit: u32 = { <"digit"> }
pub Number: u32 = { <ds:Digit+> => ds.into_iter().fold(0u32, |n, d| n * 10 + d) }

