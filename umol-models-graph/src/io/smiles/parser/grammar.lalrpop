use umol_data::Element;

use lalrpop_util::ParseError;
use crate::io::ir::{Atom, Bond, BondDir, BondOrder, BondSymbol, Chirality, Molecule, SourceFormat};
use crate::io::smiles::lexer::{LexicalError, Token};
use crate::io::smiles::state::{ParseState, BondInfo, ResolvedBond};

grammar(state: &mut ParseState);

// Molecule: one or more components separated by '.'
pub Molecule: () = {
    <Component> <TailComponents> =>? Ok(()) ,
}

// Component: a branched chain that finalizes into a molecule
pub Component: () = {
<StartChain> =>? { state.finish_chain().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; state.finish_molecule();
                     // append any nested molecules finalized within branches
                     let mut pending = std::mem::take(&mut state.pending_molecules);
                     state.molecules.append(&mut pending);
                     Ok(()) },
}

// StartChain ensures the first atom of a component does not connect to a previous component
pub StartChain: () = {
    <StartNode> <StartChainTail> =>? Ok(()),
}

pub DotSep: () = {
    "." =>? { state.split_component().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

pub TailComponents: () = {
    <DotSep> <Component> <TailComponents> =>? Ok(()),
    =>? Ok(()),
}

// Chain: used inside branches or after the first atom of a component
pub Chain: () = {
    <Node> <ChainTail> =>? Ok(()),
}

pub Link: () = {
    <Ring> =>? Ok(()),
    <Node> =>? Ok(()),
    <Bond> <Node> =>? Ok(()),
}

pub StartChainTail: () = {
    =>? Ok(()),
    <StartChainTail> <Link> =>? Ok(()),
}

pub ChainTail: () = {
    <Link> <ChainTail> =>? Ok(()),
    =>? Ok(()),
}

// Branch-local components separated by '.' within parentheses
// BranchLocal component tail reused by OpenBranchDot, defined once above

// Atom + connect/push side effects for linked atoms
pub AtomBond: () = {
<a:Atom> =>? { let mut atom = a; atom.index = Some(state.next_atom_idx as u32);
                                      let new_idx = state.bump_atom_idx();
                                      // hint aromaticity of the next atom for implicit bond defaults
                                      let is_arom = atom.aromatic.unwrap_or(false);
                                      state.next_atom_is_aromatic = Some(is_arom);
                                      if let Some(rb) = state.link_to(new_idx).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })? { state.push_resolved_bond(rb); }
                                      state.push_atom(atom);
                                      state.last_atom_idx = new_idx; Ok(()) },
}

// AtomStart: first atom of a component, do not connect to previous component
pub AtomStart: () = {
<a:Atom> =>? { let mut atom = a; atom.index = Some(state.next_atom_idx as u32);
                                      let new_idx = state.bump_atom_idx();
                                      // No link_to here; top-level component start
                                      state.push_atom(atom);
                                      state.last_atom_idx = new_idx; Ok(()) },
}

// StartNode: first atom in a component, then zero or more branches
pub StartNode: () = {
    <AtomStart> =>? Ok(()),
    <StartNode> <Branch> =>? Ok(()),
}

// Node: Atom with zero or more sibling branches
pub Node: () = {
    <AtomBond> =>? Ok(()),
    <Node> <Branch> =>? Ok(()),
}

// Branch forms per OpenSMILES: (Chain), (Bond Chain), (. Chain)
pub Branch: () = {
    <OpenBranchNone> <Chain> ")" =>? { state.close_branch().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    <OpenBranchWithBond> <Chain> ")" =>? { state.close_branch().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    <OpenBranchNone> <Chain> <BranchDotTail> ")" =>? { state.exit_comp(); state.close_branch().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    <OpenBranchWithBond> <Chain> <BranchDotTail> ")" =>? { state.exit_comp(); state.close_branch().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    <OpenBranchDot> <StartChain> <BranchCompsTail> ")" =>? { state.exit_comp(); state.close_branch().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

pub OpenBranchNone: () = {
    "(" =>? { state.open_branch(None).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

pub OpenBranchWithBond: () = {
    "(" <order:BondOrder> =>? { state.open_branch(Some(BondInfo { order, dir: None })).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    "(" "/" =>? { state.open_branch(Some(BondInfo { order: BondOrder::Single, dir: Some(BondDir::Up) })).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
    "(" "\\" =>? { state.open_branch(Some(BondInfo { order: BondOrder::Single, dir: Some(BondDir::Down) })).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

// (. StartChain ('.' StartChain)*) inside branch; enter a nested component context
pub OpenBranchDot: () = {
    "(" "." =>? { state.open_branch(None).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; state.enter_comp(); state.split_component().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

pub BranchDotSep: () = {
    "." =>? { state.enter_comp(); state.split_component().map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(()) },
}

pub BranchComps: () = {
    <Chain> <BranchCompsTail> =>? Ok(()),
}

pub BranchCompsTail: () = {
    <DotSep> <StartChain> <BranchCompsTail> =>? Ok(()),
    =>? Ok(()),
}

pub BranchDotTail: () = {
    <BranchDotSep> <StartChain> <BranchCompsTail> =>? Ok(()),
}

// Atom forms allowed at node positions
pub Atom: Atom = {
    BracketAtom,
    AliphaticOrganicSymbol,
    AromaticOrganicSymbol,
    UnknownSymbol,
}

pub BracketAtom: Atom = {
    "[" <isotope:Isotope?> <symbol:Symbol> <chirality:Chirality?> <hcount:HCount?> <charge:Charge?> <class:Class?> "]" => {
        let mut atom = symbol;
        atom.isotope = isotope;
        atom.chirality = chirality;
        atom.hydrogen_count = hcount;
        atom.charge = charge;
        atom.class = class;
        if let Some(ch) = chirality {
            let _ = state.stereo_open(state.next_atom_idx, Some(ch), 0);
        }
        atom
    },
}

pub Symbol: Atom = {
    AliphaticSymbol,
    AromaticSymbol,
    UnknownSymbol,
}

