        "@" => Token::Clockwise,
        "@@" => Token::CounterClockwise,
        "@TH" => Token::Tetrahedral,
        "@AL" => Token::Allenal,
        "@SP" => Token::SquarePlanar,
        "@TB" => Token::TrigonalBipyramidal,
        "@OH" => Token::Octahedral,

        "+" => Token::Plus,
        "-" => Token::Minus,
        "++" => Token::PlusTwo,
        "--" => Token::MinusTwo,
        "=" => Token::Equal,
        "#" => Token::Hash,
        "$" => Token::Dollar,
        ":" => Token::Colon,
        "/" => Token::Slash,
        "\\" => Token::Backslash,
        "." => Token::Dot,

        "stop" => Token::Stop,

        "error" => Token::Error,
    }
}
