pub AromaticSymbol: Atom = {
    "b" => Atom::from_aromatic_atom(Element::B),
    "c" => Atom::from_aromatic_atom(Element::C),
    "n" => Atom::from_aromatic_atom(Element::N),
    "o" => Atom::from_aromatic_atom(Element::O),
    "p" => Atom::from_aromatic_atom(Element::P),
    "s" => Atom::from_aromatic_atom(Element::S),
    "se" => Atom::from_aromatic_atom(Element::Se),
    "as" => Atom::from_aromatic_atom(Element::As),
}

pub UnknownSymbol: Atom = {
    "*" => Atom::default(),
}

pub AromaticOrganicSymbol: Atom = {
    "b" => Atom::from_aromatic_atom(Element::B),
    "c" => Atom::from_aromatic_atom(Element::C),
    "n" => Atom::from_aromatic_atom(Element::N),
    "o" => Atom::from_aromatic_atom(Element::O),
    "s" => Atom::from_aromatic_atom(Element::S),
    "p" => Atom::from_aromatic_atom(Element::P),
}

pub Isotope: u32 = {
    <mass:"digit1"> => mass,
    <mass:"digit2"> => mass,
    <mass:"digit3"> => mass,
}

pub Chirality: Chirality = {
    "@" => Chirality::Clockwise,
    "@@" => Chirality::CounterClockwise,
    "@TH" <arr:"digit1"> => Chirality::Tetrahedral { arr},
    "@AL" <arr:"digit1"> => Chirality::Allenal { arr},
    "@SP" <arr:"digit1"> => Chirality::SquarePlanar { arr},
    "@TB" <arr:"digit1"> => Chirality::TrigonalBipyramidal { arr},
    "@TB" <arr:"digit2"> => Chirality::TrigonalBipyramidal { arr},
    "@OH" <arr:"digit1"> => Chirality::Octahedral { arr},
    "@OH" <arr:"digit2"> => Chirality::Octahedral { arr},
}

pub HCount: u32 = {
    "H" => 1u32,
    "H" <count:"digit1"> => count,
}

pub Charge: i32 = {
    "+" => 1i32,
    "-" => -1i32,
    "++" => 2i32,
    "--" => -2i32,
    "+" <count:"digit1"> => count as i32,
    "-" <count:"digit1"> => -(count as i32),
}

pub Class: u32 = {
    ":" <index:"digit1"> => index,
    ":" <index:"digit2"> => index,
    ":" <index:"digit3"> => index,
}

// Bond nonterminals
pub Bond: Bond = {
<order:BondOrder> =>? { state.stage_bond_order(order).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::from_order(order)) },
"/" =>? { state.stage_bond_dir(BondDir::Up).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::up()) },
"\\" =>? { state.stage_bond_dir(BondDir::Down).map_err(|_| ParseError::User { error: LexicalError::InvalidToken })?; Ok(Bond::down()) },
}

pub BondOrder: BondOrder = {
    "-" => BondOrder::Single,
    "=" => BondOrder::Double,
    "#" => BondOrder::Triple,
    "$" => BondOrder::Quadruple,
}

