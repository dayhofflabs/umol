; Si2H2: one Si-Si bond and two 3c2e H bridges; HW I, p. 1090.
; Neutral contributions follow the diborane allocation (PW).
{:config-overrides {:atom {:charge :zero :implicit-hydrogens :zero}}
 :input {:atoms ["Si" "Si" "H" "H"]
         :bonds [[0 1 "1"]]
         :multicenter-bonds [{:atoms [0 2 1] :attrs "[1,1,0]#c0#u0#s1"}
                            {:atoms [0 3 1] :attrs "[0,1,1]#c0#u0#s1"}]}}
