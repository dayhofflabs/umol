; Al2Me6, two 3c2e Al-C-Al bridges; HW I, pp. 1023-1024.
; Neutral contributions follow the diborane convention: PW.
{:config-overrides {:atom {:charge :zero :implicit-hydrogens :zero}}
 :input {:atoms ["Al" "Al" "C#h2" "C#h2" "C#h3" "C#h3"
                 "C#h3" "C#h3" "H" "H"]
         :bonds [[0 4 :single] [0 5 :single] [1 6 :single] [1 7 :single]
                 [2 8 :single] [3 9 :single]]
         :multicenter-bonds [{:atoms [0 2 1] :attrs "[1,1,0]#c0#u0#s1"}
                            {:atoms [0 3 1] :attrs "[0,1,1]#c0#u0#s1"}]}}
